# Default: local model through Ollama (no API key, nothing leaves your machine)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1
LLM_API_KEY=ollama

# Bring your own key instead (any OpenAI-compatible API):
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...

AGENT_MAX_STEPS=6
